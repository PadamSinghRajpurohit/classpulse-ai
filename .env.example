# Local mode runs without external accounts or paid services.
AUTH_BACKEND=local

# Optional Supabase backend. Create a free Supabase project, then set these
# in your local .env or deployment secrets. Never use a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SYNC_ENABLED=false

# Optional Gemini text summaries. Keep this value private and out of GitHub.
# The app should only send de-identified aggregate metrics after explicit opt-in.
GEMINI_API_KEY=
USE_GEMINI=false
